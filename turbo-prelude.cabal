cabal-version:      2.4
name:               turbo-prelude
version:            1.0.10.0

synopsis: Alternate prelude and extra library

license-file: LICENSE
license:	  LGPL-3.0-only
author:       loglob
maintainer:   loglob

library
    exposed-modules:
        Control.Attempt
        Data.Or
        Data.SignedSet
        Turbo.Prelude
        Turbo.Cast
    build-depends:
        base,
        containers,
        lens,
        template-haskell,
        text
    other-modules:
        Turbo.Extra
        Turbo.ExtraTH
        Turbo.Operators
        Turbo.OperatorsTH
        Turbo.RootPrelude
    default-extensions:
        BlockArguments
        LambdaCase
        NoImplicitPrelude
        TemplateHaskell
        TupleSections
    ghc-options:
        -Wall
        -Wextra
        -Wno-name-shadowing
    hs-source-dirs:   .
    default-language: Haskell2010
